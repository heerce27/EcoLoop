<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F4FAF5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- ================================================= -->
        <!-- HEADER -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- BACK BUTTON -->

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="start"
                android:backgroundTint="#DDF2E0"
                android:contentDescription="Back"
                android:src="@android:drawable/ic_media_previous"
                 />

            <!-- TITLE -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Add Activity"
                android:textAlignment="center"
                android:textColor="#1B1B1B"
                android:textSize="28sp"
                android:textStyle="bold" />

            <!-- SUBTITLE -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Track your eco-friendly activities"
                android:textAlignment="center"
                android:textColor="#555555"
                android:textSize="16sp" />

        </LinearLayout>


        <!-- ================================================= -->
        <!-- SELECT ACTIVITY -->
        <!-- ================================================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="#FFFFFF"
            android:elevation="5dp"
            android:orientation="vertical"
            android:padding="20dp">


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Select Activity"
                android:textColor="#1B5E20"
                android:textSize="18sp"
                android:textStyle="bold" />


            <Spinner
                android:id="@+id/spinnerActivity"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="12dp"
                android:background="#E8F5E9" />

        </LinearLayout>


        <!-- ================================================= -->
        <!-- DYNAMIC FORM -->
        <!-- ================================================= -->

        <LinearLayout
            android:id="@+id/formContainer"
            android:layout_width="match_parent"
            android:layout_height="420dp"
            android:layout_marginTop="20dp"
            android:orientation="vertical" />


        <!-- ================================================= -->
        <!-- SUBMIT BUTTON -->
        <!-- ================================================= -->

        <Button
            android:id="@+id/btnSubmitActivity"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="24dp"
            android:backgroundTint="#2EAD63"
            android:text="Submit"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />


        <!-- ================================================= -->
        <!-- HOW ECOLOOP WORKS -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:background="#FFFFFF"
            android:elevation="3dp"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="How EcoLoop Works"
                android:textColor="#1B1B1B"
                android:textSize="21sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="3dp"
                android:text="Select an activity and enter the required information. EcoLoop calculates the estimated carbon footprint and awards points based on your activity."
                android:textColor="#444444"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:lineSpacingExtra="3dp"
                android:text="A photo proof is required for every activity. Points are awarded only when valid photo proof is provided."
                android:textColor="#444444"
                android:textSize="14sp" />

        </LinearLayout>


        <!-- ================================================= -->
        <!-- FOOTER -->
        <!-- ================================================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="12dp"
            android:text="🌱 Every small action makes a difference!"
            android:textAlignment="center"
            android:textColor="#555555"
            android:textSize="14sp"
            android:textStyle="italic" />

    </LinearLayout>

</ScrollView>