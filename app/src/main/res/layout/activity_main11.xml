<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4FAF5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">


        <!-- ================================================= -->
        <!-- HEADER -->
        <!-- ================================================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ADMIN DASHBOARD"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#1B5E20"
            android:gravity="center"
            android:padding="15dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="EcoLoop Management Panel"
            android:textSize="15sp"
            android:textColor="#666666"
            android:gravity="center"
            android:layout_marginBottom="20dp" />


        <!-- ================================================= -->
        <!-- STATISTICS -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="DASHBOARD STATISTICS"
                android:textSize="19sp"
                android:textStyle="bold"
                android:textColor="#1B5E20"
                android:layout_marginBottom="15dp" />


            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="TOTAL USERS"
                android:textSize="14sp"
                android:textColor="#666666" />

            <TextView
                android:id="@+id/txtTotalUsers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="0"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="#2E7D32"
                android:layout_marginBottom="15dp" />


            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="TOTAL ACTIVITIES"
                android:textSize="14sp"
                android:textColor="#666666" />

            <TextView
                android:id="@+id/txtTotalActivities"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="0"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="#2E7D32"
                android:layout_marginBottom="15dp" />


            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="TOTAL POINTS"
                android:textSize="14sp"
                android:textColor="#666666" />

            <TextView
                android:id="@+id/txtTotalPoints"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="0"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="#2E7D32"
                android:layout_marginBottom="15dp" />


            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="TOTAL CARBON FOOTPRINT"
                android:textSize="14sp"
                android:textColor="#666666" />

            <TextView
                android:id="@+id/txtTotalCarbon"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="0.00 kg"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="#2E7D32" />

        </LinearLayout>


        <!-- ================================================= -->
        <!-- REFRESH -->
        <!-- ================================================= -->

        <Button
            android:id="@+id/btnRefresh"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="20dp"
            android:text="REFRESH DASHBOARD"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#2E7D32" />


        <!-- ================================================= -->
        <!-- REGISTERED USERS -->
        <!-- ================================================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="REGISTERED USERS"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#1B5E20"
            android:layout_marginTop="30dp"
            android:layout_marginBottom="12dp" />


        <EditText
            android:id="@+id/searchUser"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Search user by name"
            android:singleLine="true"
            android:inputType="text"
            android:padding="15dp"
            android:textColor="#000000"
            android:textColorHint="#777777"
            android:backgroundTint="#2E7D32" />


        <LinearLayout
            android:id="@+id/usersContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="15dp" />


        <!-- ================================================= -->
        <!-- USER ACTIVITIES -->
        <!-- ================================================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="USER ACTIVITIES"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#1B5E20"
            android:layout_marginTop="30dp"
            android:layout_marginBottom="12dp" />


        <LinearLayout
            android:id="@+id/activitiesContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />


        <!-- ================================================= -->
        <!-- LOGOUT -->
        <!-- ================================================= -->

        <Button
            android:id="@+id/btnAdminLogout"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="30dp"
            android:layout_marginBottom="20dp"
            android:text="ADMIN LOGOUT"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#D32F2F" />

    </LinearLayout>

</ScrollView>