<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F4FAF5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Welcome to"
                    android:textColor="#657568"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="EcoLoop 🌱"
                    android:textColor="#1B5E20"
                    android:textSize="28sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <ImageButton
                android:id="@+id/btnProfile"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:backgroundTint="#DDF2E0"
                android:contentDescription="Profile"
                android:padding="12dp"
                android:src="@android:drawable/ic_menu_myplaces"
                />

        </LinearLayout>


        <!-- CARBON CARD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="#DFF3E2"
            android:elevation="4dp"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🌍 Your Carbon Impact"
                android:textColor="#1B5E20"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Make small changes. Create a bigger impact."
                android:textColor="#4F6353"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="12.4 kg CO₂"
                android:textColor="#145A1A"
                android:textSize="30sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Estimated impact this week"
                android:textColor="#617263"
                android:textSize="13sp" />

        </LinearLayout>


        <!-- SECTION TITLE -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Explore EcoLoop"
            android:textColor="#173D1C"
            android:textSize="21sp"
            android:textStyle="bold" />


        <!-- ADD ACTIVITY -->
        <Button
            android:id="@+id/btnAddActivity"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="14dp"
            android:text="➕  Add Activity"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="#2E7D32" />


        <!-- AI ADVISOR -->
        <Button
            android:id="@+id/btnAIAdvisor"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="12dp"
            android:text="🤖  AI Carbon Advisor"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="#388E3C" />


        <!-- CIRCULAR ACTIONS -->
        <Button
            android:id="@+id/btnCircular"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="12dp"
            android:text="♻  Circular Actions"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="#43A047" />


        <!-- BEFORE YOU BUY -->
        <Button
            android:id="@+id/btnBeforeBuy"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="12dp"
            android:text="🛒  Before You Buy"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="#558B2F" />


        <!-- RECYCLING -->
        <Button
            android:id="@+id/btnRecycling"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="12dp"
            android:text="♻  Recycling Map"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="#689F38" />


        <!-- CHALLENGES -->
        <Button
            android:id="@+id/btnChallenges"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="12dp"
            android:text="🏆  Eco Challenges"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="#7CB342" />


        <!-- AI RECOMMENDATION -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:background="#FFF8E1"
            android:elevation="3dp"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💡 AI Recommendation"
                android:textColor="#6D4C00"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Try using public transport or walking for short trips. It can help reduce your carbon impact."
                android:textColor="#665B3A"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnAcceptRecommendation"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:text="Accept Recommendation"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:backgroundTint="#689F38" />

        </LinearLayout>


        <!-- FOOTER -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="20dp"
            android:gravity="center"
            android:text="🌱 Small actions • Better future • EcoLoop"
            android:textColor="#718074"
            android:textSize="13sp" />

    </LinearLayout>

</ScrollView>